linux (26.04)	Install distro dependencies	sources=$(grep -lE 'http://archive\.ubuntu\.com/ubuntu' "$apt_root"/sources.list "$apt_root"/sources.list.d/* 2>/dev/null || true)
linux (26.04)	Install distro dependencies	if [ -n "$sources" ]; then
linux (26.04)	Install distro dependencies	  up=() down=()
linux (26.04)	Install distro dependencies	  for host in us.archive.ubuntu.com mirrors.edge.kernel.org azure.archive.ubuntu.com archive.ubuntu.com; do
linux (26.04)	Install distro dependencies	    probe="exec 3<>/dev/tcp/$host/80; printf 'HEAD /ubuntu/dists/noble/InRelease HTTP/1.0\r\nHost: $host\r\n\r\n' >&3; head -n 1 <&3 | grep -q ' 200 '"
linux (26.04)	Install distro dependencies	    if timeout 8 bash -c "$probe" 2>/dev/null; then up+=("$host"); else down+=("$host"); fi
linux (26.04)	Install distro dependencies	  done
linux (26.04)	Install distro dependencies	  priority=0
linux (26.04)	Install distro dependencies	  : > "$apt_root/putgd-mirrors.txt"
linux (26.04)	Install distro dependencies	  for host in "${up[@]}" "${down[@]}"; do
linux (26.04)	Install distro dependencies	    priority=$((priority + 1))
linux (26.04)	Install distro dependencies	    printf 'http://%s/ubuntu/\tpriority:%d\n' "$host" "$priority" >> "$apt_root/putgd-mirrors.txt"
linux (26.04)	Install distro dependencies	  done
linux (26.04)	Install distro dependencies	  sed -i -E "s#http://archive\.ubuntu\.com/ubuntu/?#mirror+file:$apt_root/putgd-mirrors.txt#" $sources
linux (26.04)	Install distro dependencies	  echo "Ubuntu mirrors reachable: ${up[*]:-none}"
linux (26.04)	Install distro dependencies	fi
