    "archive": {
        "folders": {
            "images": null,
            "other": null,
            "text": null,
            "videos": null
        },
        "keepUploads": true,
        "root": "/tmp/sab2/archive"
    },
    "limits": {
        "clipboardTextBytes": 16777216,
        "concurrentUploads": 3,
        "imageBytes": 536870912,
        "imagePixels": 100000000,
        "maxBatchBytes": "auto",
        "maxFileBytes": "auto",
        "maxFiles": 100,
        "pendingArtifactBytes": "auto",
        "pendingImageBytes": 67108864,
        "pendingOperations": 8,
        "recordingAnimationEdge": 1280,
        "recordingAnimationSeconds": 60
    },
    "naming": {
        "captureTemplate": "Screen-Capture-{yyyy}-{MM}-{dd}-{HH}-{mm}-{ss}.{ext}",
        "collisionPolicy": "rename",
        "fileTemplate": "{name}.{ext}",
        "imageTemplate": "Image-{yyyy}-{MM}-{dd}-{HH}-{mm}-{ss}.{ext}",
        "mode": "original",
        "recordingTemplate": "Screen-Recording-{yyyy}-{MM}-{dd}-{HH}-{mm}-{ss}.{ext}",
        "textTemplate": "Text-{yyyy}-{MM}-{dd}-{HH}-{mm}-{ss}.{ext}"
    },
    "preferences": {
        "launchAtLogin": false,
        "notifications": true,
        "scrollCaptureFromTop": true,
        "scrollCaptureMaxHeight": 30000,
        "uploadClipboardBehavior": "each_link"
    },
    "profiles": [
        {
            "credentials": {
                "mode": "session",
                "reference": null
            },
            "id": "sweep-http",
            "label": "Sweep offline acceptance",
            "provider": "custom-http",
            "settings": {
                "accepts": [
                    "file"
                ],
                "allowInsecureHttp": true,
                "arguments": [
                ],
                "body": "multipart",
                "connectTimeoutMs": 10000,
                "data": "",
                "dataSecret": false,
                "deletionUrl": "{json:files[0].delete}",
                "errorMessage": "",
                "fileFormName": "file",
                "headers": [
                ],
                "parameters": [
                ],
                "requestMethod": "POST",
                "requestTimeoutMs": 600000,
                "requestUrl": "http://127.0.0.1:35671/upload/json",
                "responseUrl": "{json:files[0].url}",
                "secrets": [
                ],
                "thumbnailUrl": ""
            }
        }
    ],
    "retention": {
        "failedArtifactDays": 7,
        "historyRetentionDays": null,
        "previewCacheBytes": 268435456,
        "recentActivityLimit": 100
    },
    "schemaVersion": 1
