<labwc_config version="5">
	<desktops number="4">
		<popupTime>1000</popupTime>
	</desktops>
	<keyboard>
		<numlock>off</numlock>
		<keybind key="XF86AudioNext" managed="labwc-bridge">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Next" />
		</keybind>
		<keybind key="XF86AudioPause" managed="labwc-bridge">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Pause" />
		</keybind>
		<keybind key="XF86AudioPlay" managed="labwc-bridge">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.PlayPause" />
		</keybind>
		<keybind key="XF86AudioPrev" managed="labwc-bridge">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Previous" />
		</keybind>
		<keybind key="XF86AudioStop" managed="labwc-bridge">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Stop" />
		</keybind>
		<keybind bridge="plugins.media-keys/magnifier" key="A-W-8">
			<action name="ToggleMagnify" />
		</keybind>
		<keybind bridge="plugins.media-keys/magnifier-zoom-in" key="A-W-equal">
			<action name="ZoomIn" />
		</keybind>
		<keybind bridge="plugins.media-keys/magnifier-zoom-out" key="A-W-minus">
			<action name="ZoomOut" />
		</keybind>
		<keybind bridge="plugins.media-keys/terminal" key="C-A-t">
			<action name="Execute" command="bash -c &quot;for c in xdg-terminal-exec x-terminal-emulator gnome-terminal konsole; do if command -v \$c &gt;/dev/null; then exec \$c; break; fi; done&quot;" />
		</keybind>
		<keybind bridge="plugins.media-keys/home" key="XF86Explorer">
			<action name="Execute" command="xdg-open ." />
		</keybind>
		<keybind bridge="plugins.media-keys/calculator" key="XF86Calculator">
			<action name="Execute" command="bash -c &quot;for c in gnome-calculator mate-calc kcalc; do if command -v \$c &gt;/dev/null; then exec \$c; break; fi; done&quot;" />
		</keybind>
		<keybind bridge="plugins.media-keys/email" key="XF86Mail">
			<action name="Execute" command="xdg-email" />
		</keybind>
		<keybind bridge="plugins.media-keys/www" key="XF86WWW">
			<action name="Execute" command="xdg-open about:blank" />
		</keybind>
		<keybind bridge="plugins.media-keys/www" key="XF86HomePage">
			<action name="Execute" command="xdg-open about:blank" />
		</keybind>
		<keybind bridge="plugins.media-keys/control-center" key="XF86Tools">
			<action name="Execute" command="budgie-desktop-settings" />
		</keybind>
		<keybind bridge="plugins.media-keys/media" key="XF86AudioMedia">
			<action name="Execute" command="bash -c 'gtk-launch $(xdg-mime query default audio/mpeg)'" />
		</keybind>
		<keybind bridge="plugins.media-keys/mic-mute" key="XF86AudioMicMute">
			<action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
		</keybind>
		<keybind bridge="plugins.media-keys/volume-down" key="XF86AudioLowerVolume">
			<action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
		</keybind>
		<keybind bridge="plugins.media-keys/volume-down" key="C-XF86AudioLowerVolume">
			<action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
		</keybind>
		<keybind bridge="plugins.media-keys/volume-mute" key="XF86AudioMute">
			<action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
		</keybind>
		<keybind bridge="plugins.media-keys/volume-up" key="XF86AudioRaiseVolume">
			<action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
		</keybind>
		<keybind bridge="plugins.media-keys/volume-up" key="C-XF86AudioRaiseVolume">
			<action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
		</keybind>
		<keybind bridge="plugins.media-keys/screensaver" key="W-l">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieScreenlock /org/buddiesofbudgie/Screenlock org.buddiesofbudgie.BudgieScreenlock.Lock" />
		</keybind>
		<keybind bridge="plugins.media-keys/logout" key="C-A-Delete">
			<action name="Execute" command="budgie-session-quit" />
		</keybind>
		<keybind bridge="plugins.media-keys/screen-brightness-up" key="XF86MonBrightnessUp">
			<action name="Execute" command="budgie-brightness-helper --up" />
		</keybind>
		<keybind bridge="plugins.media-keys/screen-brightness-down" key="XF86MonBrightnessDown">
			<action name="Execute" command="budgie-brightness-helper --down" />
		</keybind>
		<keybind bridge="plugins.media-keys/next" key="XF86AudioNext">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Next" />
		</keybind>
		<keybind bridge="plugins.media-keys/next" key="C-XF86AudioNext">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Next" />
		</keybind>
		<keybind bridge="plugins.media-keys/previous" key="XF86AudioPrev">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Previous" />
		</keybind>
		<keybind bridge="plugins.media-keys/previous" key="C-XF86AudioPrev">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Previous" />
		</keybind>
		<keybind bridge="plugins.media-keys/play" key="XF86AudioPlay">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.PlayPause" />
		</keybind>
		<keybind bridge="plugins.media-keys/play" key="C-XF86AudioPlay">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.PlayPause" />
		</keybind>
		<keybind bridge="plugins.media-keys/pause" key="XF86AudioPause">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Pause" />
		</keybind>
		<keybind bridge="plugins.media-keys/stop" key="XF86AudioStop">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieMprisController /org/buddiesofbudgie/MprisController org.buddiesofbudgie.BudgieMprisController.Stop" />
		</keybind>
		<keybind bridge="wm.keybindings/show-desktop" key="W-d">
			<action name="ToggleShowDesktop" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-left" key="W-S-Page_Up">
			<action name="SendToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-left" key="W-S-KP_Prior">
			<action name="SendToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-left" key="W-S-A-Left">
			<action name="SendToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-left" key="C-S-A-Left">
			<action name="SendToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-right" key="W-S-Page_Down">
			<action name="SendToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-right" key="W-S-KP_Next">
			<action name="SendToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-right" key="W-S-A-Right">
			<action name="SendToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-right" key="C-S-A-Right">
			<action name="SendToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-last" key="W-S-End">
			<action name="SendToDesktop" to="1" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/move-to-workspace-1" key="W-S-Home">
			<action name="SendToDesktop" to="1" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-last" key="W-End">
			<action name="GoToDesktop" to="last" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-1" key="W-Home">
			<action name="GoToDesktop" to="1" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-left" key="W-Page_Up">
			<action name="GoToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-left" key="W-KP_Prior">
			<action name="GoToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-left" key="W-A-Left">
			<action name="GoToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-left" key="C-A-Left">
			<action name="GoToDesktop" to="left" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-right" key="W-Page_Down">
			<action name="GoToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-right" key="W-KP_Next">
			<action name="GoToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-right" key="W-A-Right">
			<action name="GoToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-to-workspace-right" key="C-A-Right">
			<action name="GoToDesktop" to="right" wrap="no" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-applications-backward" key="S-W-Tab">
			<action name="PreviousWindow" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-applications-backward" key="S-A-Tab">
			<action name="PreviousWindow" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-applications" key="W-Tab">
			<action name="NextWindow" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-applications" key="A-Tab">
			<action name="NextWindow" />
		</keybind>
		<keybind bridge="wm.keybindings/cycle-windows-backward" key="S-A-Escape">
			<action name="PreviousWindow" />
		</keybind>
		<keybind bridge="wm.keybindings/cycle-windows" key="A-Escape">
			<action name="NextWindow" />
		</keybind>
		<keybind bridge="gnome.mutter/overlay-key" key="Super_L" onRelease="yes">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.budgie_desktop.Panel /org/budgie_desktop/Panel org.budgie_desktop.Panel.ActivateAction int32:2" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/clear-notifications" key="W-c">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.budgie_desktop.Raven /org/budgie_desktop/Raven org.budgie_desktop.Raven.ClearNotifications" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/toggle-notifications" key="W-n">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.budgie_desktop.Raven /org/budgie_desktop/Raven org.budgie_desktop.Raven.ToggleNotificationsView" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/toggle-raven" key="W-a">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.budgie_desktop.Raven /org/budgie_desktop/Raven org.budgie_desktop.Raven.ToggleAppletView" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/take-region-screenshot" key="C-Print">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieScreenshotControl /org/buddiesofbudgie/ScreenshotControl org.buddiesofbudgie.BudgieScreenshotControl.StartAreaSelect" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/take-full-screenshot" key="Print">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.BudgieScreenshotControl /org/buddiesofbudgie/ScreenshotControl org.buddiesofbudgie.BudgieScreenshotControl.StartFullScreenshot" />
		</keybind>
		<keybind bridge="solus-project.budgie-wm/show-power-dialog" key="W-S-p">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.PowerDialog /org/buddiesofbudgie/PowerDialog org.buddiesofbudgie.PowerDialog.Toggle" />
		</keybind>
		<keybind bridge="wm.keybindings/panel-run-dialog" key="A-F2">
			<action name="Execute" command="budgie-run-dialog" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-input-source" key="A-Shift_L">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.KeyboardLayout /org/buddiesofbudgie/KeyboardLayout org.buddiesofbudgie.KeyboardLayout.SwitchLayoutNext" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-input-source" key="W-space">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.KeyboardLayout /org/buddiesofbudgie/KeyboardLayout org.buddiesofbudgie.KeyboardLayout.SwitchLayoutNext" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-input-source" key="XF86Keyboard">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.KeyboardLayout /org/buddiesofbudgie/KeyboardLayout org.buddiesofbudgie.KeyboardLayout.SwitchLayoutNext" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-input-source-backward" key="W-S-space">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.KeyboardLayout /org/buddiesofbudgie/KeyboardLayout org.buddiesofbudgie.KeyboardLayout.SwitchLayoutPrevious" />
		</keybind>
		<keybind bridge="wm.keybindings/switch-input-source-backward" key="S-XF86Keyboard">
			<action name="Execute" command="dbus-send --type=method_call --dest=org.buddiesofbudgie.KeyboardLayout /org/buddiesofbudgie/KeyboardLayout org.buddiesofbudgie.KeyboardLayout.SwitchLayoutPrevious" />
		</keybind>
		<keybind bridge="wm.keybindings/close" key="A-F4">
			<action name="Close" />
		</keybind>
		<keybind bridge="wm.keybindings/minimize" key="W-h">
			<action name="Iconify" />
		</keybind>
		<keybind bridge="wm.keybindings/maximize" key="W-Up">
			<action name="Maximize" direction="both" />
		</keybind>
		<keybind bridge="wm.keybindings/begin-resize" key="A-F8">
			<action name="Resize" />
		</keybind>
		<keybind bridge="wm.keybindings/unmaximize" key="W-Down">
			<action name="UnMaximize" direction="both" />
		</keybind>
		<keybind bridge="wm.keybindings/unmaximize" key="A-F5">
			<action name="UnMaximize" direction="both" />
		</keybind>
		<keybind bridge="wm.keybindings/toggle-maximized" key="A-F10">
			<action name="ToggleMaximize" direction="both" />
		</keybind>
		<keybind bridge="mutter.keybindings/toggle-tiled-left" key="W-Left">
			<action name="ToggleSnapToEdge" direction="left" />
		</keybind>
		<keybind bridge="mutter.keybindings/toggle-tiled-right" key="W-Right">
			<action name="ToggleSnapToEdge" direction="right" />
		</keybind>
	</keyboard>
	<theme>
		<name>Pocillo-dark</name>
		<dropShadows>yes</dropShadows>
		<font place="ActiveWindow" name="Adwaita Sans" weight="Bold" size="11" slant="Normal" />
		<font place="InactiveWindow" name="Adwaita Sans" weight="Bold" size="11" slant="Normal" />
		<titlebar>
			<layout>:iconify,max,close:</layout>
		</titlebar>
		<icon>Papirus</icon>
	</theme>
	<windowRules>
		<windowRule identifier="Nemo-desktop" title="Desktop" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="ToggleAlwaysOnBottom" />
		</windowRule>
		<windowRule identifier="nemo-desktop" title="nemo-desktop" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="ToggleAlwaysOnBottom" />
		</windowRule>
		<windowRule identifier="budgie-power-dialog" title="budgie-power-dialog" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="AutoPlace" policy="center" />
		</windowRule>
		<windowRule identifier="budgie-daemon" title="budgie-daemon" skipTaskbar="yes" skipWindowSwitcher="yes">
			<action name="AutoPlace" policy="center" />
		</windowRule>
	</windowRules>
	<placement>
		<policy>center</policy>
	</placement>
	<focus>
		<followMouse>no</followMouse>
		<raiseOnFocus>no</raiseOnFocus>
		<raiseOnFocusDelay>500</raiseOnFocusDelay>
	</focus>
	<snapping>
		<range inner="10" outer="10">10</range>
	</snapping>
	<windowSwitcher style="thumbnail" allWorkspaces="no" />
	<mouse>
		<doubleClickTime>400</doubleClickTime>
		<default />
		<context name="Desktop">
			<mousebind button="Left" action="Press">
				<action name="Focus" />
			</mousebind>
			<mousebind button="Right" action="Press">
				<action name="ShowMenu" menu="root-menu" />
			</mousebind>
		</context>
	</mouse>
	<libinput>
		<device category="touchpad">
			<naturalScroll>yes</naturalScroll>
			<leftHanded>no</leftHanded>
			<pointerSpeed>0.0</pointerSpeed>
			<accelProfile>flat</accelProfile>
			<tap>yes</tap>
			<tapButtonMap>default</tapButtonMap>
			<tapAndDrag>yes</tapAndDrag>
			<dragLock>no</dragLock>
			<middleEmulation>no</middleEmulation>
			<disableWhileTyping>yes</disableWhileTyping>
			<scrollMethod>twofinger</scrollMethod>
			<clickMethod>clickfinger</clickMethod>
			<sendEventsMode>yes</sendEventsMode>
		</device>
		<device category="non-touch">
			<naturalScroll>no</naturalScroll>
			<leftHanded>no</leftHanded>
			<pointerSpeed>0.0</pointerSpeed>
			<accelProfile>flat</accelProfile>
			<middleEmulation>no</middleEmulation>
		</device>
	</libinput>
</labwc_config>