                531,
                36
            ],
            "text": "Use bucket policy"
        },
        {
            "checkable": true,
            "checked": false,
            "class": "QToolButton",
            "enabled": true,
            "kind": "button",
            "name": "b2LinkModeHelp",
            "rect": [
                387,
                312,
                24,
                24
            ],
            "text": "Public links never expire and require public read access. Private bucket gives S3 uploads a signed GET link and Backblaze B2 uploads a download authorization link, lasting 1–7 days. This setting does not change bucket policy. S3 uses its endpoint host; temporary credentials may expire sooner."
        },
        {
            "class": "QComboBox",
