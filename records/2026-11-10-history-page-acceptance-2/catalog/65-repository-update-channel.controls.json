        {
            "checkable": true,
            "checked": false,
            "class": "QToolButton",
            "enabled": true,
            "kind": "button",
            "name": "checkForUpdatesHelp",
            "rect": [
                452,
                440,
                24,
                24
            ],
            "text": "Once a day put.gd asks app.put.gd for the newest version on its channel. The request is the same from every computer: no version, account, locale or ID. The comparison happens here, and nothing is installed without you. Stable builds also show a notification once for each new version; nightly builds show it only here. Check now works with daily checks off."
        },
        {
            "checkable": true,
            "checked": true,
            "class": "QCheckBox",
            "enabled": true,
            "kind": "button",
            "name": "checkForUpdates",
            "rect": [
                968,
                435,
                24,
                36
            ],
            "text": "Check for updates once a day"
        },
        {
            "checkable": true,
            "checked": false,
            "class": "QToolButton",
            "enabled": true,
            "kind": "button",
            "name": "updateChannelHelp",
            "rect": [
                320,
                493,
                24,
                24
            ],
            "text": "Starts on the channel of this build: a nightly build follows nightly, a release or release candidate follows stable. Choose the other one to watch it instead. Changing it doesn't change what is installed: an AppImage then offers to switch to that channel's newest release, which you start yourself. A DEB or RPM that updates from put.gd's apt or dnf repository follows that repository's channel instead, which only you change, in a terminal."
        },
