            "kind": "button",
            "name": "s3RequestTimeoutMsControlHelp",
            "rect": [
                373,
                523,
                24,
                24
            ],
            "text": "The request timeout shown in seconds, with millisecond precision. The default is 60 seconds. It controls the storage client's request timeout. Allow enough time for your connection and file sizes; a timed-out upload may still need reconciliation before its remote result is known."
        },
        {
            "class": "QDoubleSpinBox",
            "enabled": true,
            "kind": "stepper",
            "name": "s3RequestTimeoutMsControl",
            "rect": [
                461,
