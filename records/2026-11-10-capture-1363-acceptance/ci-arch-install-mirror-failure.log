2026-11-10T04:07:37.9039564Z   name: arch-install-evidence
2026-11-10T04:07:37.9039708Z   path: build/arch-smoke/
2026-11-10T04:07:37.9039839Z   if-no-files-found: warn
2026-11-10T04:07:37.9039970Z   compression-level: 6
